{
  "name": "@socifyr/sdk",
  "version": "0.3.0",
  "description": "Official TypeScript SDK for Socifyr, the social publishing API for teams and AI agents. Publish to 18 platforms with one call",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "socifyr",
    "social-media",
    "api",
    "sdk",
    "instagram",
    "tiktok",
    "youtube",
    "facebook",
    "linkedin",
    "twitter",
    "threads",
    "pinterest",
    "reddit",
    "bluesky",
    "social-media-api",
    "social-media-posting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Socifyr/socifyr-node"
  },
  "homepage": "https://socifyr.com/docs/sdk",
  "bugs": {
    "url": "https://github.com/Socifyr/socifyr-node/issues"
  }
}
